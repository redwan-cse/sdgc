# Copy to .env.local. Retrieve keys with npm run db:status; never commit real keys.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server/test scripts only. Never add a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Local development payment simulation (offline / test dues)
NEXT_PUBLIC_LOCAL_PAYMENTS_ENABLED=true
LOCAL_PAYMENTS_SIMULATION=true

